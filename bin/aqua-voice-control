#!/bin/bash
set -euo pipefail

BRIDGE="${AQUA_BRIDGE_BIN:-$HOME/.local/lib/aqua-voice/aqua-bridge}"
SETTINGS="${AQUA_SETTINGS_BIN:-$HOME/.local/lib/aqua-voice/aqua-settings.js}"
AUTH="${AQUA_AUTH_BIN:-$HOME/.local/lib/aqua-voice/aqua-auth.js}"
HOTKEY="${AQUA_HOTKEY_BIN:-$HOME/.local/lib/aqua-voice/aqua-hotkey.js}"

offline_status() {
  local snapshot auth hotkey
  snapshot=$("$SETTINGS" status)
  auth=$("$AUTH" status)
  hotkey=$("$HOTKEY" status)
  jq -cn --argjson snapshot "$snapshot" --argjson auth "$auth" --argjson hotkey "$hotkey" \
    '{ok:false,phase:"offline",recording:false,processing:false,hotkeyReady:false,hotkeyTaps:0,hotkeyDisplay:$hotkey.hotkey.display,microphone:"PipeWire default",pasteWithShift:false,tokenPresent:$auth.connected,account:$auth.account,latestTranscript:"",error:"Backend is not running",settings:$snapshot.settings,history:$snapshot.history}'
}

case "${1:-status}" in
  start) systemctl --user start aqua-voice.service ;;
  stop) systemctl --user stop aqua-voice.service ;;
  restart) systemctl --user restart aqua-voice.service ;;
  status) "$BRIDGE" status 2>/dev/null || offline_status ;;
  trigger) "$BRIDGE" "${2:?tap|start|stop|cancel|paste-last}" ;;
  copy-history) "$BRIDGE" "copy-history:${2:?history entry id}" ;;
  paste-history) "$BRIDGE" "paste-history:${2:?history entry id}" ;;
  dictionary)
    action="${2:?add|remove|sync}"
    if [[ "$action" == "sync" ]]; then
      "$SETTINGS" sync-customizations
    elif [[ "$action" == "add" || "$action" == "remove" ]]; then
      IFS= read -r word
      printf '%s' "$word" | "$SETTINGS" "dictionary-$action"
    else
      echo "dictionary action must be add, remove, or sync" >&2
      exit 2
    fi
    ;;
  settings) "$SETTINGS" "${2:-status}" "${3:-}" "${4:-}" ;;
  auth)
    action="${2:-status}"
    if [[ "$action" == "callback" ]]; then
      printf '%s' "${3:?callback URL}" | "$AUTH" callback-stdin
    else
      "$AUTH" "$action"
    fi
    ;;
  record-hotkey) "$HOTKEY" capture ;;
  hotkey) "$HOTKEY" "${2:-status}" ;;
  clear-history) "$BRIDGE" clear-history 2>/dev/null || "$SETTINGS" clear-history ;;
  log) journalctl --user -u aqua-voice.service -n "${2:-100}" --no-pager ;;
  *) echo "usage: aqua-voice-control start|stop|restart|status|trigger <start|stop|cancel>|copy-history <id>|paste-history <id>|dictionary <add|remove|sync>|settings <status|set|toggle>|auth <status|login|callback|migrate|logout>|record-hotkey|hotkey [status|ensure]|clear-history|log [lines]" >&2; exit 2 ;;
esac
